    "@types/jest": "29.4.0",
    "@types/supertest": "2.0.12",
    "jest": "29.5.0",
    "jest-serial-runner": "^1.2.1",
    "prettier": "2.8.4",
    "supertest": "6.3.3",
    "ts-jest": "29.0.5",
    "typemoq": "^2.1.0"
  }
}
